# MiraMedia runtime environment variables.
#
# Defaults reference — values below match code defaults unless noted.
# Copy to `.env` and override only what you need, then source it or reference
# via `env_file:` in your compose stack. Operators with spare RAM/CPU may
# intentionally raise concurrency or cache limits above these baselines.

# -------------------- Timezone --------------------
# Container/process timezone (IANA name) — the FALLBACK for air-date parsing and
# the upcoming/calendar window when the in-app Timezone setting is left blank.
# Cinemeta reports air times as UTC datetimes, so an evening US broadcast lands on
# the *next* UTC day; a real zone here (or set in the UI) keeps the calendar right.
# Precedence: UI Settings → General → Timezone  overrides  this TZ  overrides  UTC.
TZ=UTC

# -------------------- Database pools --------------------
# Request-path pool. Bump on busy multi-user deployments.
MIRAMEDIA_DB_POOL_SIZE=20
MIRAMEDIA_DB_MAX_OVERFLOW=20
# Background-task pool (scheduler / imports / metadata refresh).
MIRAMEDIA_DB_BG_POOL_SIZE=10
MIRAMEDIA_DB_BG_MAX_OVERFLOW=10

# -------------------- AnyIO threadpool --------------------
# Ceiling on the threadpool used by FastAPI for blocking `def` routes +
# `asyncio.to_thread` calls. Don't lower this below ~80 unless you know
# your library is small.
MIRAMEDIA_THREADPOOL_SIZE=200

# -------------------- TaskIQ scheduler --------------------
# Two priority lanes — interactive (user-triggered: add show/movie, manual
# scan, manual resolve) and background (cron sweeps: auto-import, metadata
# refresh, sha1 audit, scheduled scans, log cleanup). Each lane runs its own
# Receiver against its own broker (separate NOTIFY channel + message table),
# so a multi-minute background sweep can't queue behind / starve a manual
# UI action.
#
# Sum these to your total concurrency budget. Code defaults are 8 interactive +
# 2 background; raise both on bigger hosts or lower on tiny NAS deployments
# (see docker-compose.synology.yaml for NAS-tuned values).
MIRAMEDIA_INTERACTIVE_TASK_LIMIT=8
MIRAMEDIA_BACKGROUND_TASK_LIMIT=2

# Legacy back-compat: if the two lane vars above are unset and this one IS
# set, the total is split 80/20 (interactive/background). Prefer the two
# lane vars above on new deployments.
# MIRAMEDIA_RECEIVER_MAX_TASKS=20

# -------------------- Uvicorn workers --------------------
# Number of uvicorn worker processes. Each worker is a full Python
# interpreter w/ libtorrent + chromium for cloudflare bypass ≈ 300 MB
# resident. Keep at 1 on NAS / low-RAM hosts (the default). On a bigger
# host set to roughly `nproc / 2` and read the scheduler-isolation note
# below before going above 1.
MIRAMEDIA_WEB_WORKERS=1

# When MIRAMEDIA_WEB_WORKERS > 1 the in-process taskiq scheduler MUST
# move to a dedicated container. Each worker that runs the scheduler
# spawns its own Receiver + cron loop, so leaving this at the default
# `false` on every worker makes every scheduled task fire N times
# (duplicate imports, duplicate metadata refreshes, duplicate notifications).
#
# Topology for multi-worker:
#   - API service: MIRAMEDIA_WEB_WORKERS=N, MIRAMEDIA_SCHEDULER_DISABLED=true
#   - Sidecar scheduler container: MIRAMEDIA_WEB_WORKERS=1,
#     MIRAMEDIA_SCHEDULER_DISABLED=false (the only process that owns
#     broker startup + the cron loop)
# See the commented `miramedia-scheduler` block in docker-compose.yaml
# for a copy-paste template.
MIRAMEDIA_SCHEDULER_DISABLED=false

# -------------------- Torrent client RPC --------------------
# Cap concurrent qBittorrent / libtorrent status calls. Above ~20 the
# clients start throttling or dropping requests.
MIRAMEDIA_TORRENT_RPC_CONCURRENCY=10

# -------------------- SHA1 integrity audit --------------------
# Disk-bound; concurrency above ~8 starves the array on spinning rust.
# NAS / Synology defaults drop this to 1 (see docker-compose.synology.yaml).
MIRAMEDIA_SHA1_CONCURRENCY=4

# -------------------- libmediainfo concurrency --------------------
# Caps concurrent ``MediaInfo.parse()`` invocations during bulk imports +
# library scans. Each call is a blocking C-lib invocation that forks/IOs
# heavily on spinning rust. Default 2 for NAS; raise to 4-6 on SSD arrays.
MIRAMEDIA_MEDIAINFO_CONCURRENCY=2

# -------------------- Chromium (cloudflare bypass) --------------------
# Process-wide cap on concurrent chromium operations (solves + fetches).
# A single tab + renderer + GPU + zygote tree costs ~150MB; on a 2GB NAS
# two concurrent CF challenges risks OOM. Default 1; bump to 2 on hosts
# with >= 4GB RAM.
MIRAMEDIA_CHROMIUM_CONCURRENCY=1

# -------------------- Metadata cache --------------------
# In-process TTL cache around TMDB / TVDB / native metadata providers.
# Default TTL = 24h. Drop to ~3600 if you frequently edit metadata
# upstream and want changes visible sooner.
MIRAMEDIA_METADATA_CACHE_TTL_SECONDS=86400
MIRAMEDIA_METADATA_CACHE_MAXSIZE=1024

# -------------------- Notifications --------------------
# Suppress duplicate outbound notifications with the same title + message
# within this window (seconds). Default 900 (15 min).
MIRAMEDIA_NOTIFY_SUPPRESS_SECONDS=900

# -------------------- Activity log handler --------------------
# Dedicated psycopg pool used by the background log writer thread.
MIRAMEDIA_LOG_POOL_SIZE=5

# -------------------- Auth cache --------------------
# Short-lived TTL cache around JWT token -> user lookups. Skips a JWT decode
# and DB round-trip on every cached request — dominant per-request cost on
# single-worker NAS setups. Revocation latency is bounded by the TTL;
# role/active/email changes via the UserManager invalidate immediately.
# Drop the TTL to 0 to disable. Lower the maxsize if memory is scarce.
MIRAMEDIA_AUTH_CACHE_TTL_SECONDS=30
MIRAMEDIA_AUTH_CACHE_MAXSIZE=2048

# -------------------- Frontend mount --------------------
# Set to TRUE if you put a reverse proxy in front of the api and want it
# to serve /app/web/build directly — FastAPI then skips mounting the SPA
# itself and only handles /api/* + /openapi.json. Default deployments
# leave this unset and let FastAPI's CachedStaticFiles mount serve the
# Next static export.
# MIRAMEDIA_DISABLE_FRONTEND_MOUNT=

# -------------------- Logging --------------------
# DEBUG / INFO / WARNING / ERROR. INFO is the prod default.
# MIRAMEDIA_LOG_LEVEL=INFO
# Set to /dev/null to disable file logging (container manager captures stdout).
# MIRAMEDIA_LOG_FILE=

# -------------------- Disk scan (list endpoints) --------------------
# Movies/Shows list endpoints scan the library tree to compute on-disk state.
# Results are cached; concurrency caps parallel stat() fan-out.
# MIRAMEDIA_DISK_SCAN_CONCURRENCY=8
# MIRAMEDIA_DISK_SCAN_CACHE_TTL=30        # seconds

# -------------------- Indexer fan-out + circuit breaker --------------------
# Cap concurrent site searches and trip a per-site breaker after repeated
# failures so one dead tracker can't stall the whole fan-out.
# MIRAMEDIA_INDEXER_FANOUT_LIMIT=8
# MIRAMEDIA_INDEXER_FANOUT_TIMEOUT=300            # seconds, whole fan-out budget
# MIRAMEDIA_INDEXER_CIRCUIT_FAILURES=3            # consecutive fails before open
# MIRAMEDIA_INDEXER_CIRCUIT_COOLDOWN_SECONDS=300  # open-state cooldown

# -------------------- Cloudflare bypass breaker --------------------
# Per-domain circuit breaker around the CF solver, plus a hard cap on fetches
# served per harvested browser session before it's recycled.
# MIRAMEDIA_BYPASS_BREAKER_THRESHOLD=3      # consecutive solve fails before open
# MIRAMEDIA_BYPASS_BREAKER_COOLDOWN=600     # seconds
# MIRAMEDIA_BYPASS_MAX_FETCHES=25           # curl_cffi replays per session
# Force-kill ALL tracked chrome helpers on shutdown (diagnostics only).
# MIRAMEDIA_CHROMIUM_NUKE=

# -------------------- Library watcher (optional) --------------------
# Lightweight polling loop that auto-detects new files dropped into library
# dirs. Off by default — enable for drop-folder workflows.
# MIRAMEDIA_LIBRARY_WATCHER=false
# MIRAMEDIA_LIBRARY_WATCHER_INTERVAL=120    # seconds (min 30)

# -------------------- Misc internals --------------------
# Recycle pooled DB connections older than this (seconds) to dodge stale
# server-side timeouts.
# MIRAMEDIA_DB_POOL_RECYCLE=240
# Bound on the in-memory activity-log queue before the writer drains it.
# MIRAMEDIA_LOG_QUEUE_MAX=20000
# Per-IP rate limit (per minute) for the Web Vitals beacon endpoint.
# MIRAMEDIA_VITALS_RATE_LIMIT_PER_MIN=60
# HLS transcode segment cache dir (streaming).
# MIRAMEDIA_HLS_CACHE=/app/images/hls
# Disable the SSE event bridge (live UI push). Polling still works.
# MIRAMEDIA_EVENT_BRIDGE_DISABLED=false

# -------------------- TOML config overrides --------------------
# Pydantic-settings nested override syntax: `MIRAMEDIA_<SECTION>__<KEY>`.
# Examples:
#   MIRAMEDIA_DATABASE__HOST=db
#   MIRAMEDIA_MISC__DEVELOPMENT=TRUE
#   MIRAMEDIA_MISC__CORS_URLS=["http://localhost:8080"]

# -------------------- Observability --------------------
# No env vars required — these endpoints are always on.
#
# `prometheus-fastapi-instrumentator` exposes per-route latency
# histograms + cache hit-rate gauges at `/metrics`. Scrape from any
# Prometheus-compatible collector; no tunables.
#
# Web Vitals (LCP/INP/CLS/FCP/TTFB) are POSTed by the frontend to
# `/api/v1/analytics/vitals` and emitted to structured logs with
# `vital_name` / `vital_value` / `vital_rating` extras. Forward to
# Loki/Promtail/Datadog for aggregation. The endpoint is hidden from
# OpenAPI (operator-facing) but always accepts beacons.
#
# Postgres slow-query log is enabled in all three compose files via
# `-c log_min_duration_statement=500` — any statement > 500ms shows in
# `docker logs miramedia-postgres`. Tune the threshold in the compose
# `command:` block, not via env vars.
