{
  "name": "web",
  "version": "1.1.7",
  "private": true,
  "sideEffects": [
    "*.css",
    "src/lib/mediabunny.ts",
    "src/instrumentation*.ts",
    "src/instrumentation-client*.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "build:generated": "_FUMADOCS_MDX=1 next build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "typecheck:generated": "tsc --noEmit",
    "format": "oxfmt",
    "openapi": "openapi-typescript http://localhost:8001/openapi.json --root-types --root-types-no-schema-prefix -o src/lib/api/api.d.ts",
    "openapi:from-file": "node scripts/openapi-from-file.mjs public/openapi.json -o src/lib/api/api.d.ts",
    "generate": "fumadocs-mdx && _FUMADOCS_MDX=1 next typegen",
    "docs:gen": "fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mediabunny/ac3": "^1.62.1",
    "@orama/orama": "^3.1.18",
    "@scalar/api-reference-react": "^0.9.82",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "geist": "^1.8.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.25.0"
}
