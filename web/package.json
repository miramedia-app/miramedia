{
  "name": "web",
  "version": "1.1.2",
  "private": true,
  "sideEffects": [
    "*.css",
    "src/lib/mediabunny.ts",
    "src/instrumentation*.ts",
    "src/instrumentation-client*.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "build:generated": "_FUMADOCS_MDX=1 next build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "typecheck:generated": "tsc --noEmit",
    "format": "oxfmt",
    "openapi": "openapi-typescript http://localhost:8001/openapi.json --root-types --root-types-no-schema-prefix -o src/lib/api/api.d.ts",
    "openapi:from-file": "node scripts/openapi-from-file.mjs public/openapi.json -o src/lib/api/api.d.ts",
    "generate": "fumadocs-mdx && _FUMADOCS_MDX=1 next typegen",
    "docs:gen": "fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mediabunny/ac3": "^1.55.3",
    "@orama/orama": "^3.1.18",
    "@scalar/api-reference-react": "^0.9.61",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.15.4",
    "geist": "^1.7.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "mediabunny": "^1.55.3",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "@redocly/openapi-core>js-yaml": ">=4.3.1 <5",
      "openapi-typescript>typescript": "$typescript5",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
