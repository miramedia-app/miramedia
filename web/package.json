{
  "name": "web",
  "version": "1.0.8",
  "private": true,
  "sideEffects": [
    "*.css",
    "src/lib/mediabunny.ts",
    "src/instrumentation*.ts",
    "src/instrumentation-client*.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "pnpm run generate && tsgo --noEmit",
    "typecheck:generated": "tsgo --noEmit",
    "format": "oxfmt",
    "openapi": "openapi-typescript http://localhost:8001/openapi.json --root-types --root-types-no-schema-prefix -o src/lib/api/api.d.ts",
    "generate": "fumadocs-mdx && _FUMADOCS_MDX=1 next typegen",
    "docs:gen": "fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@mediabunny/ac3": "^1.50.7",
    "@orama/orama": "^3.1.18",
    "@scalar/api-reference-react": "^0.9.53",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.11.1",
    "fumadocs-mdx": "^15.1.0",
    "fumadocs-ui": "^16.11.1",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "mediabunny": "^1.50.7",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.12.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260629.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
