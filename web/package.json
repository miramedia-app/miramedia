{
  "name": "web",
  "version": "1.0.15",
  "private": true,
  "sideEffects": [
    "*.css",
    "src/lib/mediabunny.ts",
    "src/instrumentation*.ts",
    "src/instrumentation-client*.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "build:generated": "_FUMADOCS_MDX=1 next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm run generate && tsgo --noEmit",
    "typecheck:generated": "tsgo --noEmit",
    "format": "oxfmt",
    "openapi": "openapi-typescript http://localhost:8001/openapi.json --root-types --root-types-no-schema-prefix -o src/lib/api/api.d.ts",
    "generate": "fumadocs-mdx && _FUMADOCS_MDX=1 next typegen",
    "docs:gen": "fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@mediabunny/ac3": "^1.52.3",
    "@orama/orama": "^3.1.18",
    "@scalar/api-reference-react": "^0.9.60",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.14.1",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.1",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.29.0",
    "mediabunny": "^1.52.3",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260629.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
